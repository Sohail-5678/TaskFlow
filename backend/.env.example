# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local ($0): leave as the SQLite default below.
DATABASE_URL=sqlite+aiosqlite:///./taskflow.db
# Production (free Postgres) examples — pick ONE and uncomment:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME        # Azure Database for PostgreSQL (free tier)
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require  # Neon (free)

# --- CORS (comma-separated) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,https://taskflow.vercel.app

ENVIRONMENT=development
